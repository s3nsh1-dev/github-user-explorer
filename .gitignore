# Centralized .gitignore (client + netlify functions)

# Node modules
node_modules/
client/node_modules/

# Build output
dist/
build/
client/dist/
client/build/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment variables
.env
.env.*
client/.env*
# ...but the template is committed on purpose. Keep this after the rules above.
!.env.example

# OS + Editor junk
.DS_Store
Thumbs.db

# IDE/editor folders
.vscode/
.idea/
*.sw?

# Misc
*.local
*.cache/
.cache/
client/.cache/

# Optional: Lock files (if you're not committing them)
# package-lock.json
# yarn.lock

# Local Netlify folder
.netlify

# Personal working notes — audit reports, implementation plans, debugging logs.
# Read locally, never shipped. Keep the folder out of the repo entirely.
report/
